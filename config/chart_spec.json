{
  "version": "0.2",
  "note": "每個分頁要畫哪些圖。series/bars/line 的值為 xbrl_zh_map.json 的 concept id 或 derived id。改圖表只改此檔，不動程式。",
  "segment_note": "分部分頁的圖：列是動態的（各家揭露的分部成員不同），所以不指定 concept id 而指定「來源」。source=concept 取該科目的成員列（不含上層匯總），source=derived 取衍生區塊（block 為區塊中文標題）。每張圖對每個分部軸各畫一次；欄範圍只取季度段，季度不足 4 期時改取年度段。",
  "segment_charts": [
    {
      "type": "stacked_bar",
      "title": "各分部營收",
      "source": "concept",
      "concept": "revenue",
      "y_format": "money"
    },
    {
      "type": "line",
      "title": "分部營收佔比",
      "source": "derived",
      "block": "營收佔比",
      "y_format": "percent"
    },
    {
      "type": "line",
      "title": "分部毛利率",
      "source": "derived",
      "block": "分部毛利率",
      "y_format": "percent"
    },
    {
      "type": "line",
      "title": "分部營業利益率",
      "source": "derived",
      "block": "分部營業利益率",
      "y_format": "percent"
    }
  ],
  "sheets": {
    "損益表": [
      {
        "type": "bar+line",
        "title": "營收與毛利率",
        "bars": ["revenue"],
        "line": ["gross_margin"],
        "secondary_axis": true
      },
      {
        "type": "stacked_bar",
        "title": "成本費用結構",
        "series": ["cogs", "rnd", "sgna"]
      },
      {
        "type": "line",
        "title": "三率趨勢",
        "series": ["gross_margin", "operating_margin", "net_margin"]
      }
    ],
    "資產負債表": [
      {
        "type": "stacked_bar",
        "title": "資產結構",
        "series": ["cash", "accounts_receivable", "inventory", "ppe_net", "goodwill"]
      },
      {
        "type": "bar+line",
        "title": "淨負債與利息保障倍數",
        "bars": ["net_debt"],
        "line": ["interest_coverage"],
        "secondary_axis": true
      }
    ],
    "現金流量表": [
      {
        "type": "bar",
        "title": "三大現金流",
        "series": ["cfo", "cfi", "cff"]
      },
      {
        "type": "bar+line",
        "title": "自由現金流與 FCF Margin",
        "bars": ["fcf"],
        "line": ["fcf_margin"],
        "secondary_axis": true
      }
    ],
    "關鍵指標": [
      {
        "type": "line",
        "title": "營收成長動能",
        "series": ["revenue_yoy", "revenue_qoq"],
        "y_format": "percent"
      },
      {
        "type": "line",
        "title": "報酬率",
        "series": ["roe", "roa", "roic"],
        "y_format": "percent"
      },
      {
        "type": "bar",
        "title": "現金轉換循環",
        "series": ["dso", "dio", "dpo", "ccc"],
        "y_format": "days"
      },
      {
        "type": "line",
        "title": "盈餘品質",
        "series": ["ocf_to_net_income"],
        "y_format": "multiple"
      }
    ]
  }
}
